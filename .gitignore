# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Data files (adjust extensions to your needs)
*.npy
*.npz
*.h5
*.hdf5
*.pkl
*.pt
*.pth
*.mat
*.csv
*.nc

# Large output folders
outputs/
results/
logs/
checkpoints/
runs/

# Exception: the session-28 provenance ledger is git-tracked (every manuscript
# number traces to it via paper/macros.tex; master plan Track 0 / gate GI).
!outputs/
outputs/*
!outputs/session28/
outputs/session28/*
!outputs/session28/numbers.json
# Session 31 Track F ROM report ledger: numbers.json + CI dump + built table are
# git-tracked so every manuscript ROM number traces to them via macros_session31.tex.
!outputs/session31/
outputs/session31/*
!outputs/session31/numbers.json
!outputs/session31/numbers_ablation.json
!outputs/session31/numbers_reference.json
!outputs/session31/ci_dump.json
!outputs/session31/tables/
outputs/session31/tables/*
!outputs/session31/tables/*.tex

# Session 32: track the small result/gate JSONs (provenance for D217-D235); the
# checkpoints, latent caches (q1_pool_latents/), and logs stay ignored.
!outputs/session32/
outputs/session32/*
!outputs/session32/*.json

# Session 36: track the small result JSONs (Track M1 shared-operator merit,
# M2b parameter floor; provenance for D310-D312). Operator checkpoints and
# caches stay ignored.
!outputs/session36/
outputs/session36/*
!outputs/session36/*.json

# Exception: paper manuscript figures live under paper/sections/figures/results/
# even though the top-level results/ folder is ignored.
!paper/sections/figures/results/
!paper/sections/figures/results/*

# IDE
.vscode/
.idea/
*.swp

# Claude Code local state (settings overrides, schedule locks)
.claude/

# Local pre-pivot backups (talk + paper snapshots kept on disk, not in history)
*.BACKUP_*
paper_BACKUP_precond/

# OS
.DS_Store
Thumbs.db

# Environment variables / secrets
.env
*.key

